      <aliases enabled='yes' />
      <column caption='Total job Posting' datatype='integer' name='[Calculation_0108419138187264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([job_posting_year])' />
      </column>
      <column caption='Total Job Posting' datatype='integer' name='[Calculation_0108419140755457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([job_id])' />
      </column>
      <column caption='Average Salary' datatype='real' name='[Calculation_0108419141672962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([salary])' />
      </column>
      <column caption='High urgency job' datatype='integer' name='[Calculation_0108419143512068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#10;IF [hiring_urgency] = &quot;High&quot;&#10;THEN [job_id]&#10;END&#10;)' />
      </column>
      <column caption='Average Experience' datatype='real' name='[Calculation_0108419149893638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([years_experience])' />
      </column>
      <column caption='Total jobs' datatype='integer' name='[Calculation_0108419163029511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([job_id])' />
      </column>
      <column caption='py' datatype='integer' name='[Calculation_0108419259297803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [skills_python] = 1 THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='py 2' datatype='real' default-format='p0.00%' name='[Calculation_0108419264016396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0108419259297803]) / COUNTD([job_id])' />
      </column>
      <column caption='SQL Demand' datatype='real' default-format='p0.00%' name='[Calculation_0108419264823309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([skills_sql])/ COUNT([job_id])' />
      </column>
      <column caption='ML Deamand' datatype='real' default-format='p0.00%' name='[Calculation_0108419265585166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([skills_ml]) / COUNTD([job_id])' />
      </column>
      <column caption='DL Deamand' datatype='real' default-format='p0.00%' name='[Calculation_0108419266662415]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([skills_deep_learning])/ COUNTD([job_id])' />
      </column>
      <column caption='Cloud Demand' datatype='real' default-format='p0.00%' name='[Calculation_0108419267371024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([skills_cloud]) / COUNTD([job_id])' />
      </column>
      <column caption='Skills comibiantio python + SQL' datatype='string' name='[Calculation_0108419268468753]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0108419264016396] = 1 AND [Calculation_0108419264823309] = 1&#10;THEN &quot;Python + SQL&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='hiring urgency' datatype='real' default-format='p0.00%' name='[Calculation_0108419304402963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [hiring_urgency] = &quot;High&quot;&#10;    THEN [job_id]&#10;    END&#10;)&#10;/&#10;COUNTD([job_id])' />
      </column>
      <column caption='Total job posting 1' datatype='integer' name='[Calculation_0108419306377236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([job_id])' />
      </column>
